# gRPC voice server (fraud service)
SERVER_ADDRESS=vision.futuremedialab.tw:60015

# Access token for the edge device.
# Leave blank to log in via QR code on first run; the token obtained that way is
# cached to EDGE_TOKEN_FILE and reused on subsequent runs.
EDGE_TOKEN=

# Backend base URL (through nginx) used for the QR device-login endpoints.
BACKEND_URL=https://vision.futuremedialab.tw:1688

# Where the QR-login access token is cached between runs.
EDGE_TOKEN_FILE=.edge_token

# ICE servers for the WebRTC handoff to kebbi (comma-separated).
# Public STUN only for now; append a TURN URL here later if media fails across NATs,
# e.g. ICE_SERVERS=stun:stun.l.google.com:19302,turn:user:pass@turn.example.com:3478
ICE_SERVERS=stun:stun.l.google.com:19302

